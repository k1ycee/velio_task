# Copy to .env (git-ignored) and set a real password. Docker Compose reads .env automatically;
# the server's npm scripts (start:dev, migrate, test:e2e) read it too.
POSTGRES_USER=velio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=velio

# Used by the server outside Docker (npm run start:dev / migrate / test:e2e). Inside Docker,
# docker-compose.yml builds its own URL from the values above. Keep the password in step.
DATABASE_URL=postgres://velio:change-me@localhost:5432/velio
REDIS_URL=redis://localhost:6379
